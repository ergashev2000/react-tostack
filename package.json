{
  "name": "react-tostack",
  "version": "0.1.1",
  "description": "iOS Dynamic Island style toasts for React. Spring physics, stacking, glass surfaces, light and dark themes. Written in TypeScript.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "keywords": [
    "react",
    "toast",
    "toaster",
    "notification",
    "notifications",
    "dynamic-island",
    "ios",
    "snackbar",
    "typescript",
    "react-hot-toast",
    "sonner"
  ],
  "scripts": {
    "build": "tsup && node build-demo.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ergashev2000/react-tostack.git"
  },
  "homepage": "https://react-tostack.islomjon.uz",
  "bugs": {
    "url": "https://github.com/ergashev2000/react-tostack/issues"
  },
  "overrides": {
    "esbuild": "$esbuild"
  },
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "access": "public"
  }
}
