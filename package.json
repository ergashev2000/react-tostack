{
  "name": "react-tostack",
  "version": "0.1.0",
  "description": "iOS Dynamic Island style toasts for React. Spring physics, swipe to dismiss, light & dark.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "react",
    "toast",
    "notification",
    "dynamic-island",
    "ios",
    "typescript"
  ],
  "scripts": {
    "build": "tsup && node build-demo.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ergashev2000/react-tostack.git"
  },
  "homepage": "https://react-tostack.islomjon.uz",
  "bugs": {
    "url": "https://github.com/ergashev2000/react-tostack/issues"
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}
